@page "/"
@using LMSapp.Web.Services
@inject NavigationManager NavManager
@inject LmsBusinessService LmsBusinessService
@inject LmsCurrentStudentService CurrentStudentService
@inject SimpleAuthService AuthService

<div class="lms-page">
    <aside class="sidebar">
        <div class="brand">LMS Portal</div>

        <nav class="nav-links">
            <button class="nav-btn active" @onclick='() => NavigateTo("/")'>Dashboard</button>
            <button class="nav-btn" @onclick='() => NavigateTo("/courses")'>Courses</button>
            <button class="nav-btn" @onclick='() => NavigateTo("/assignments")'>Assignments</button>
            <button class="nav-btn" @onclick='() => NavigateTo("/grades")'>Grades</button>
            <button class="nav-btn" @onclick='() => NavigateTo("/calendar")'>Calendar</button>
            <button class="nav-btn" @onclick='() => NavigateTo("/settings")'>Settings</button>
        </nav>
    </aside>

    <main class="content">
        <header class="header">
            <div>
                <h1>Student Dashboard</h1>
                <p>Welcome back! Select a section below to get started.</p>
            </div>
            <div class="header-buttons">
                <button class="btn btn-secondary" @onclick="GoToAnnouncements">Announcements</button>
                <button class="btn btn-primary" @onclick="GoToProfile">My Profile</button>
            </div>
        </header>

        <section class="section">
            <h2>Quick Actions</h2>
            <div class="button-group">
                <button class="action-btn" @onclick="GoToAssignments">View Assignments</button>
                <button class="action-btn" @onclick="GoToCourseCatalog">Course Catalog</button>
                <button class="action-btn" @onclick="GoToResources">Files & Resources</button>
                <button class="action-btn" @onclick="GoToDiscussions">Class Discussions</button>
            </div>
        </section>

        <section class="section">
            <h2>My Courses</h2>
            <div class="course-list">
                @if (EnrolledCourses.Any())
                {
                    @foreach (var course in EnrolledCourses)
                    {
                        <div class="course-card">
                            <div class="course-card-header">
                                <span class="course-badge">@course.Code</span>
                                <h3>@course.Title</h3>
                            </div>
                            <p class="course-instructor">Instructor: @course.Instructor</p>

                            <div class="progress-section">
                                <div class="progress-info">
                                    <span>Progress</span>
                                    <span>@course.Progress%</span>
                                </div>
                                <div class="progress-track" role="progressbar" aria-valuenow="@course.Progress"
                                     aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-fill" style="width: @course.Progress%;"></div>
                                </div>
                            </div>

                            <button class="btn btn-primary" @onclick="() => OpenCourse(course.Id)">Go to Class</button>
                        </div>
                    }
                }
                else
                {
                    <p>No courses are currently associated with this student profile.</p>
                }
            </div>
        </section>

        <section class="section">
            <h2>Upcoming Deadlines</h2>
            @if (UpcomingAssignments.Any())
            {
                <ul class="task-list">
                    @foreach (var assignment in UpcomingAssignments.Take(5))
                    {
                        <li class="task-item">
                            <div class="task-details">
                                <span class="task-title">@assignment.Title</span>
                                <span class="course-tag">@assignment.CourseCode</span>
                                <span class="due-badge due-urgent">Due @assignment.DueDate.ToString("MMM dd")</span>
                            </div>
                            <button class="btn-small" @onclick="() => OpenTask(assignment.Id)">Open</button>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p>No assignments are currently due for this student.</p>
            }
        </section>
    </main>
</div>

@code {
    private List<CourseSummaryDto> EnrolledCourses = new();
    private List<AssignmentSummaryDto> UpcomingAssignments = new();
    private int _studentId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !await AuthService.IsLoggedInAsync())
        {
            NavManager.NavigateTo("/login");
            return;
        }

        if (firstRender)
        {
            var currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser is not null)
            {
                var student = await LmsBusinessService.GetDefaultStudentIdAsync();
                _studentId = student;
                EnrolledCourses = await LmsBusinessService.GetStudentCourseSummariesAsync(_studentId);
                UpcomingAssignments = (await LmsBusinessService.GetStudentAssignmentSummariesAsync(_studentId))
                    .OrderBy(a => a.DueDate)
                    .ToList();
                StateHasChanged();
            }
        }
    }

    private void NavigateTo(string route) => NavManager.NavigateTo(route);
    private void GoToAnnouncements() => NavigateTo("/announcements");
    private void GoToProfile() => NavigateTo("/profile");
    private void GoToAssignments() => NavigateTo("/assignments");
    private void GoToCourseCatalog() => NavigateTo("/courses/catalog");
    private void GoToResources() => NavigateTo("/resources");
    private void GoToDiscussions() => NavigateTo("/discussions");
    private void OpenCourse(int id) => NavigateTo($"/courses/{id}");
    private void OpenTask(int id) => NavigateTo($"/tasks/{id}");
}