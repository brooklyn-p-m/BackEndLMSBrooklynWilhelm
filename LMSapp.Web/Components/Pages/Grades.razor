@page "/grades"
@using LMSapp.Web.Services
@inject NavigationManager NavManager
@inject LmsBusinessService LmsBusinessService
@inject LmsCurrentStudentService CurrentStudentService
@inject SimpleAuthService AuthService

<div class="lms-page">
    <aside class="sidebar">
        <div class="brand">LMS Portal</div>

        <nav class="nav-links">
            <button class="nav-btn" @onclick='() => NavigateTo("/")'>Dashboard</button>
            <button class="nav-btn" @onclick='() => NavigateTo("/courses")'>Courses</button>
            <button class="nav-btn" @onclick='() => NavigateTo("/assignments")'>Assignments</button>
            <button class="nav-btn active" @onclick='() => NavigateTo("/grades")'>Grades</button>
            <button class="nav-btn" @onclick='() => NavigateTo("/calendar")'>Calendar</button>
            <button class="nav-btn" @onclick='() => NavigateTo("/settings")'>Settings</button>
        </nav>
    </aside>

    <main class="content">
        <header class="header">
            <div>
                <h1>Grades & Academic Standing</h1>
                <p>Review your semester performance, calculated GPA, and course evaluations.</p>
            </div>
            <div class="header-buttons">
                <button class="btn btn-secondary" @onclick="DownloadTranscript">Export Transcript</button>
                <button class="btn btn-primary" @onclick="GoToGraduationAudit">Degree Audit</button>
            </div>
        </header>

        <section class="section">
            <div class="summary-cards">
                <div class="stat-card">
                    <span class="stat-label">Term GPA</span>
                    <strong class="stat-value">@GetAverageGrade().ToString("0.00")</strong>
                    <span class="stat-sub">Current student</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Cumulative GPA</span>
                    <strong class="stat-value">@GetAverageGrade().ToString("0.00")</strong>
                    <span class="stat-sub">Across enrolled courses</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Academic Standing</span>
                    <strong class="stat-value text-success">@GetStandingText()</strong>
                    <span class="stat-sub">Based on current results</span>
                </div>
            </div>
        </section>

        <section class="section">
            <div class="section-toolbar">
                <h2>Current Term Grades</h2>
            </div>

            <div class="table-container">
                <table class="grades-table">
                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Credits</th>
                            <th>Score</th>
                            <th>Current Letter</th>
                            <th>Submitted Work</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (TermGrades.Any())
                        {
                            @foreach (var course in TermGrades)
                            {
                                <tr>
                                    <td>
                                        <strong>@course.Code</strong>
                                        <div class="course-sub">@course.Title</div>
                                    </td>
                                    <td>@course.Credits</td>
                                    <td>@course.Percentage.ToString("0.0")%</td>
                                    <td>
                                        <span class="letter-grade @GetGradeClass(course.LetterGrade)">
                                            @course.LetterGrade
                                        </span>
                                    </td>
                                    <td>@course.CompletedTasks of @course.TotalTasks Complete</td>
                                    <td>
                                        <button class="btn-small" @onclick="() => ViewCourseGradeDetails(course.Id)">View
                                            Breakdown</button>
                                        </td>
                                    </tr>
                                }
                            }
                        else
                            {
                                <tr>
                                    <td colspan="6">No grade records are available yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>

@code {
    private List<GradeSummaryDto> TermGrades = new();
    private int _studentId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !await AuthService.IsLoggedInAsync())
        {
            NavManager.NavigateTo("/login");
            return;
        }

        if (firstRender)
        {
            _studentId = CurrentStudentService.CurrentStudentId ?? await LmsBusinessService.GetDefaultStudentIdAsync();
            if (_studentId > 0)
            {
                TermGrades = await LmsBusinessService.GetStudentGradeSummariesAsync(_studentId);
            }
            StateHasChanged();
        }
    }

    private void NavigateTo(string route) => NavManager.NavigateTo(route);
    private void ViewCourseGradeDetails(int courseId) => NavigateTo($"/grades/course/{courseId}");
    private void DownloadTranscript() => NavigateTo("/grades/transcript");
    private void GoToGraduationAudit() => NavigateTo("/grades/audit");

    private string GetGradeClass(string grade) => grade switch
    {
        "A" or "A-" => "grade-a",
        "B" or "B-" => "grade-b",
        "C" or "C-" => "grade-c",
        _ => "grade-other"
    };

    private double GetAverageGrade()
    {
        if (!TermGrades.Any()) return 0;
        return TermGrades.Average(g => g.Percentage);
    }

    private string GetStandingText()
    {
        var average = GetAverageGrade();
        return average >= 80 ? "Good Standing" : average >= 60 ? "Needs Review" : "At Risk";
    }
}