@page "/courses"
@using LMSapp.Web.Services
@inject NavigationManager NavManager
@inject LmsBusinessService LmsBusinessService
@inject LmsCurrentStudentService CurrentStudentService
@inject SimpleAuthService AuthService

<div class="lms-page">
    <aside class="sidebar">
        <div class="brand">LMS Portal</div>

        <nav class="nav-links">
            <button class="nav-btn" @onclick='() => NavigateTo("/")'>Dashboard</button>
            <button class="nav-btn active" @onclick='() => NavigateTo("/courses")'>Courses</button>
            <button class="nav-btn" @onclick='() => NavigateTo("/assignments")'>Assignments</button>
            <button class="nav-btn" @onclick='() => NavigateTo("/grades")'>Grades</button>
            <button class="nav-btn" @onclick='() => NavigateTo("/calendar")'>Calendar</button>
            <button class="nav-btn" @onclick='() => NavigateTo("/settings")'>Settings</button>
        </nav>
    </aside>

    <main class="content">
        <header class="header">
            <div>
                <h1>Course Management</h1>
                <p>Browse your enrolled courses and view course content.</p>
            </div>
            <div class="header-buttons">
                <button class="btn btn-secondary" @onclick="EnrollNewCourse">+ Add Course</button>
            </div>
        </header>

        <section class="section">
            <div class="filter-bar">
                <button class="filter-btn @(currentFilter == "Current" ? "active" : "")"
                        @onclick='() => SetFilter("Current")'>Current Courses (@CourseList.Count(c => c.Status ==
                        "Current"))</button>
                    <button class="filter-btn @(currentFilter == "Completed" ? "active" : "")"
                            @onclick='() => SetFilter("Completed")'>Past Courses (@CourseList.Count(c => c.Status ==
                            "Completed"))</button>
                        <button class="filter-btn @(currentFilter == "All" ? "active" : "")"
                                @onclick='() => SetFilter("All")'>All Courses (@CourseList.Count)</button>
                    </div>
                </section>

                <section class="section">
                    <div class="courses-grid">
                        @if (FilteredCourses.Any())
                        {
                            @foreach (var course in FilteredCourses)
                            {
                                <div class="course-card">
                                    <div class="card-header">
                                        <span class="course-code">@course.Code</span>
                                        <span class="badge @course.Status.ToLower()">@course.Status</span>
                                    </div>

                                    <h3 class="course-title">@course.Title</h3>
                                    <p class="course-meta"><strong>Instructor:</strong> @course.Instructor</p>
                                    <p class="course-meta"><strong>Credits:</strong> @course.Credits</p>
                                    <p class="course-meta"><strong>Syllabus Expiration:</strong> @(course.SyllabusExp?.ToString("MMM dd, yyyy") ?? "Not set")</p>

                                    <div class="course-progress">
                                        <label>Progress: @course.Progress%</label>
                                        <div class="progress-bar">
                                            <div class="progress-fill" style="width: @(course.Progress)%;"></div>
                                        </div>
                                    </div>

                                    <div class="card-actions">
                                        <button class="btn btn-primary full-width" @onclick="() => OpenCourse(course.Id)">Open
                                            Course</button>
                                            <div class="sub-actions">
                                                <button class="btn-link" @onclick="() => GoToModules(course.Id)">Modules</button>
                                                <span>•</span>
                                                <button class="btn-link" @onclick="() => GoToAssignments(course.Id)">Assignments</button>
                                                <span>•</span>
                                                <button class="btn-link" @onclick="() => GoToSyllabus(course.Id)">Syllabus</button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                else
                            {
                                <p>No course records exist for the current student.</p>
                            }
                        </div>
                    </section>
                </main>
            </div>

@code {
    private string currentFilter = "Current";
    private List<CourseSummaryDto> CourseList = new();
    private int _studentId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !await AuthService.IsLoggedInAsync())
        {
            NavManager.NavigateTo("/login");
            return;
        }

        if (firstRender)
        {
            _studentId = CurrentStudentService.CurrentStudentId ?? await LmsBusinessService.GetDefaultStudentIdAsync();
            if (_studentId > 0)
            {
                CourseList = await LmsBusinessService.GetStudentCourseSummariesAsync(_studentId);
            }
            StateHasChanged();
        }
    }

    private void SetFilter(string filter) => currentFilter = filter;

    private IEnumerable<CourseSummaryDto> FilteredCourses =>
        currentFilter == "All"
            ? CourseList
            : CourseList.Where(c => c.Status == currentFilter);

    private void NavigateTo(string route) => NavManager.NavigateTo(route);
    private void OpenCourse(int courseId) => NavigateTo($"/courses/{courseId}");
    private void GoToModules(int courseId) => NavigateTo($"/courses/{courseId}/modules");
    private void GoToAssignments(int courseId) => NavigateTo($"/courses/{courseId}/assignments");
    private void GoToSyllabus(int courseId) => NavigateTo($"/courses/{courseId}/syllabus");
    private void EnrollNewCourse() => NavigateTo("/courses/catalog");
}