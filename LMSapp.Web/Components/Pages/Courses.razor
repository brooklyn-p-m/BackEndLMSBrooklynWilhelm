@page "/courses"
@inject NavigationManager NavManager

<div class="lms-page">
    <!-- Sidebar Navigation -->
    <aside class="sidebar">
        <div class="brand">LMS Portal</div>
        
        <nav class="nav-links">
            <button class="nav-btn" @onclick='() => NavigateTo("/")'>Dashboard</button>
            <button class="nav-btn active" @onclick='() => NavigateTo("/courses")'>Courses</button>
            <button class="nav-btn" @onclick='() => NavigateTo("/assignments")'>Assignments</button>
            <button class="nav-btn" @onclick='() => NavigateTo("/grades")'>Grades</button>
            <button class="nav-btn" @onclick='() => NavigateTo("/calendar")'>Calendar</button>
            <button class="nav-btn" @onclick='() => NavigateTo("/settings")'>Settings</button>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="content">
        <header class="header">
            <div>
                <h1>Course Management</h1>
                <p>Browse your enrolled courses and view course content.</p>
            </div>
            <div class="header-buttons">
                <button class="btn btn-secondary" @onclick="EnrollNewCourse">+ Add Course</button>
            </div>
        </header>

        <!-- Filter Controls -->
        <section class="section">
            <div class="filter-bar">
                <button class="filter-btn @(currentFilter == "Current" ? "active" : "")" 
                        @onclick='() => SetFilter("Current")'>
                    Current Courses (@CourseList.Count(c => c.Status == "Current"))
                </button>
                <button class="filter-btn @(currentFilter == "Completed" ? "active" : "")" 
                        @onclick='() => SetFilter("Completed")'>
                    Past Courses (@CourseList.Count(c => c.Status == "Completed"))
                </button>
                <button class="filter-btn @(currentFilter == "All" ? "active" : "")" 
                        @onclick='() => SetFilter("All")'>
                    All Courses (@CourseList.Count)
                </button>
            </div>
        </section>

        <!-- Courses Cards Grid -->
        <section class="section">
            <div class="courses-grid">
                @foreach (var course in FilteredCourses)
                {
                    <div class="course-card">
                        <div class="card-header">
                            <span class="course-code">@course.Code</span>
                            <span class="badge @course.Status.ToLower()">@course.Status</span>
                        </div>
                        
                        <h3 class="course-title">@course.Title</h3>
                        <p class="course-meta"><strong>Instructor:</strong> Prof. @course.Instructor</p>
                        <p class="course-meta"><strong>Term:</strong> @course.Term</p>
                        <p class="course-meta"><strong>Credits:</strong> @course.Credits</p>

                        <div class="course-progress">
                            <label>Progress: @course.Progress%</label>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: @(course.Progress)%;"></div>
                            </div>
                        </div>

                        <!-- Course Page Action Buttons -->
                        <div class="card-actions">
                            <button class="btn btn-primary full-width" @onclick="() => OpenCourse(course.Id)">
                                Open Course
                            </button>
                            <div class="sub-actions">
                                <button class="btn-link" @onclick="() => GoToModules(course.Id)">Modules</button>
                                <span>•</span>
                                <button class="btn-link" @onclick="() => GoToAssignments(course.Id)">Assignments</button>
                                <span>•</span>
                                <button class="btn-link" @onclick="() => GoToSyllabus(course.Id)">Syllabus</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    </main>
</div>

@code {
    private string currentFilter = "Current";

    private void SetFilter(string filter)
    {
        currentFilter = filter;
    }

    private IEnumerable<CourseItem> FilteredCourses =>
        currentFilter == "All" ? CourseList : CourseList.Where(c => c.Status == currentFilter);

    // Navigation methods
    private void NavigateTo(string route)
    {
        NavManager.NavigateTo(route);
    }

    private void OpenCourse(int courseId)
    {
        NavigateTo($"/courses/{courseId}");
    }

    private void GoToModules(int courseId)
    {
        NavigateTo($"/courses/{courseId}/modules");
    }

    private void GoToAssignments(int courseId)
    {
        NavigateTo($"/courses/{courseId}/assignments");
    }

    private void GoToSyllabus(int courseId)
    {
        NavigateTo($"/courses/{courseId}/syllabus");
    }

    private void EnrollNewCourse()
    {
        NavigateTo("/courses/catalog");
    }

    // Model & Initial Data
    private record CourseItem(
        int Id, 
        string Code, 
        string Title, 
        string Instructor, 
        string Term, 
        int Credits, 
        int Progress, 
        string Status
    );

    private List<CourseItem> CourseList = new()
    {
        new(1, "CS 1010", "Introduction to Programming", "Smith", "Fall 2026", 4, 75, "Current"),
        new(2, "MATH 1050", "College Algebra", "Johnson", "Fall 2026", 4, 60, "Current"),
        new(3, "ENGL 1010", "Expository Writing", "Davis", "Fall 2026", 3, 90, "Current"),
        new(4, "HIST 1700", "American Civilization", "Taylor", "Spring 2026", 3, 100, "Completed"),
        new(5, "COMM 1020", "Public Speaking", "Miller", "Spring 2026", 3, 100, "Completed")
    };
}