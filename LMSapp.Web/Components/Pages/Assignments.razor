@page "/assignments"
@using LMSapp.Web.Services
@inject NavigationManager NavManager
@inject LmsBusinessService LmsBusinessService
@inject LmsCurrentStudentService CurrentStudentService
@inject SimpleAuthService AuthService
@inject StudentService StudentService

<div class="lms-page">
    <aside class="sidebar">
        <div class="brand">LMS Portal</div>

        <nav class="nav-links">
            <button class="nav-btn" @onclick='() => NavigateTo("/")'>Dashboard</button>
            <button class="nav-btn" @onclick='() => NavigateTo("/courses")'>Courses</button>
            <button class="nav-btn active" @onclick='() => NavigateTo("/assignments")'>Assignments</button>
            <button class="nav-btn" @onclick='() => NavigateTo("/grades")'>Grades</button>
            <button class="nav-btn" @onclick='() => NavigateTo("/calendar")'>Calendar</button>
            <button class="nav-btn" @onclick='() => NavigateTo("/settings")'>Settings</button>
        </nav>
    </aside>

    <main class="content">
        <header class="header">
            <div>
                <h1>Assignments</h1>
                <p>Track due dates, upload submissions, and review graded work.</p>
            </div>
            <div class="header-buttons">
                <button class="btn btn-secondary" @onclick="GoToArchived">Archived Tasks</button>
            </div>
        </header>

        <section class="section">
            <div class="filter-bar">
                <button class="filter-btn @(currentFilter == "Pending" ? "active" : "")"
                        @onclick='() => SetFilter("Pending")'>Upcoming & Due (@AssignmentList.Count(a => a.Status ==
                        "Pending"))</button>
                    <button class="filter-btn @(currentFilter == "Submitted" ? "active" : "")"
                            @onclick='() => SetFilter("Submitted")'>Submitted (@AssignmentList.Count(a => a.Status ==
                            "Submitted"))</button>
                        <button class="filter-btn @(currentFilter == "Graded" ? "active" : "")"
                                @onclick='() => SetFilter("Graded")'>Graded (@AssignmentList.Count(a => a.Status ==
                                "Graded"))</button>
                            <button class="filter-btn @(currentFilter == "All" ? "active" : "")"
                                    @onclick='() => SetFilter("All")'>All (@AssignmentList.Count)</button>
                        </div>
                    </section>

                    <section class="section">
                        <div class="assignments-list">
                            @if (FilteredAssignments.Any())
                            {
                                @foreach (var assignment in FilteredAssignments)
                                {
                                    <div class="assignment-item">
                                        <div class="item-left">
                                            <span class="badge @assignment.Status.ToLower()">@assignment.Status</span>
                                            <div class="item-details">
                                                <h3 class="assignment-title">@assignment.Title</h3>
                                                <p class="assignment-subtext">
                                                    <span class="course-code">@assignment.CourseCode</span> •
                                                    Due: @assignment.DueDate.ToString("MMM dd, yyyy") •
                                                    @assignment.MaxPoints Pts
                                                </p>
                                            </div>
                                        </div>

                                        <div class="item-actions">
                                            @if (assignment.Status == "Pending")
                                            {
                                                <button class="btn btn-primary" @onclick="() => SubmitAssignment(assignment.Id)">Submit</button>
                                            }
                                            else if (assignment.Status == "Submitted")
                                            {
                                                <button class="btn btn-secondary" @onclick="() => ViewSubmission(assignment.Id)">View
                                                    Submission</button>
                                                }
                                else if (assignment.Status == "Graded")
                                                {
                                                    <div class="grade-tag">@assignment.Grade</div>
                                                    <button class="btn btn-outline" @onclick="() => ViewFeedback(assignment.Id)">Feedback</button>
                                                }

                                                <button class="btn-link" @onclick="() => OpenDetails(assignment.Id)">Details</button>
                                            </div>
                                        </div>
                                    }
                                }
                else
                                {
                                    <p>No assignments are currently available for this student.</p>
                                }
                            </div>
                        </section>
                    </main>
                </div>

@code {
    private string currentFilter = "Pending";
    private List<AssignmentSummaryDto> AssignmentList = new();
    private int _studentId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !await AuthService.IsLoggedInAsync())
        {
            NavManager.NavigateTo("/login");
            return;
        }

        if (firstRender)
        {
            _studentId = await ResolveCurrentStudentIdAsync();
            if (_studentId <= 0)
            {
                _studentId = await LmsBusinessService.GetDefaultStudentIdAsync();
            }

            if (_studentId > 0)
            {
                AssignmentList = await LmsBusinessService.GetStudentAssignmentSummariesAsync(_studentId);
            }
            StateHasChanged();
        }
    }

    private async Task<int> ResolveCurrentStudentIdAsync()
    {
        if (CurrentStudentService.CurrentStudentId is > 0)
        {
            return CurrentStudentService.CurrentStudentId.Value;
        }

        var currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser is null)
        {
            return 0;
        }

        var student = await StudentService.GetByAppUserIdAsync(currentUser.AppUserId);
        if (student is null)
        {
            return 0;
        }

        CurrentStudentService.SetCurrentStudent(student);
        return student.StudentsId;
    }

    private void SetFilter(string filter) => currentFilter = filter;

    private IEnumerable<AssignmentSummaryDto> FilteredAssignments =>
        currentFilter == "All"
            ? AssignmentList
            : AssignmentList.Where(a => a.Status == currentFilter);

    private void NavigateTo(string route) => NavManager.NavigateTo(route);
    private void SubmitAssignment(int id) => NavigateTo($"/assignments/{id}/submit");
    private void ViewSubmission(int id) => NavigateTo($"/assignments/{id}/submission");
    private void ViewFeedback(int id) => NavigateTo($"/assignments/{id}/feedback");
    private void OpenDetails(int id) => NavigateTo($"/assignments/{id}");
    private void GoToArchived() => NavigateTo("/assignments/archive");
}